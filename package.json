{
  "name": "dsh-session-monitor",
  "version": "0.6.0",
  "description": "Auditable, recoverable session monitoring and file management for DeepSeek Harness.",
  "license": "MIT",
  "author": "xkuno668",
  "type": "module",
  "homepage": "https://github.com/xkuno668/dsh-session-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkuno668/dsh-session-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/xkuno668/dsh-session-monitor/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session-monitor",
    "session-manager",
    "trash",
    "audit"
  ],
  "main": "./lib/index.js",
  "bin": {
    "dsh-session-monitor": "./bin/dsh-session-monitor.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "bin", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=22.15.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.1 <0.2.2-0",
    "react": "^18.2.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check bin/dsh-session-monitor.js",
    "test": "node --test test/*.test.js"
  }
}
